<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#00ACC1"
        app:title="Деталі тривоги"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/tvDetailSensor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Датчик №1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tvDetailZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Зона: Морозилка"
                android:textSize="16sp"
                android:textColor="#757575"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tvDetailTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Температура: --"
                android:textSize="18sp"
                android:textColor="#F44336"
                android:layout_marginTop="12dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDetailZoneNorm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Норма: від -- до --"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDetailStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Статус: Нова"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Час виникнення: --"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnDetailAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Прийняти в роботу"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="12dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>